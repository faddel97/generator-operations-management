NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional, organization-approved raster tile URL templates. Use {z}/{x}/{y} placeholders.
# No third-party basemap requests are made when these are unset.
NEXT_PUBLIC_TRACKING_STREET_TILES=
NEXT_PUBLIC_TRACKING_SATELLITE_TILES=
# Required only for the authenticated GPS ingestion endpoint; never expose to browser or device.
SUPABASE_SERVICE_ROLE_KEY=
